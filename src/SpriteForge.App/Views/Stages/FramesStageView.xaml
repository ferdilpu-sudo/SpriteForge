<UserControl
    x:Class="SpriteForge.App.Views.Stages.FramesStageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SpriteForge.App.Controls">
    <Grid ColumnSpacing="12" Padding="14" MinHeight="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
        <controls:CheckerboardControl ImagePath="{Binding PreviewImagePath}" Zoom="{Binding PreviewZoom}" />
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" MinHeight="0">
            <ScrollViewer Style="{StaticResource InspectorScrollViewerStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="FRAMES" Style="{StaticResource InspectorTitleStyle}" />
                    <TextBlock Text="Extract frames" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Start time (seconds)"/><NumberBox Value="{Binding ExtractionStartSeconds, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" />
                    <CheckBox Content="Use end time" IsChecked="{Binding ExtractionHasEndTime, Mode=TwoWay}" />
                    <TextBlock Text="End time (seconds)"/><NumberBox Value="{Binding ExtractionEndSeconds, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact" IsEnabled="{Binding ExtractionHasEndTime}" />
                    <TextBlock Text="Target FPS"/><NumberBox Value="{Binding PreviewFps, Mode=TwoWay}" Minimum="0.01" Maximum="120" SpinButtonPlacementMode="Compact" />

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                    <TextBlock Text="Frame optimization" Style="{StaticResource SectionTitleStyle}" />
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding FrameOptimizationMode, Mode=TwoWay}">
                        <ComboBoxItem Content="Raw · keep every frame" Tag="raw"/>
                        <ComboBoxItem Content="Compact · 6–8 keyframes" Tag="compact"/>
                        <ComboBoxItem Content="Balanced · 8–12 keyframes" Tag="balanced"/>
                        <ComboBoxItem Content="Smooth · 12–18 keyframes" Tag="smooth"/>
                    </ComboBox>
                    <NumberBox Header="Near-duplicate similarity"
                               Value="{Binding FrameSimilarityThreshold, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="1"
                               SmallChange="0.01"
                               SpinButtonPlacementMode="Compact" />
                    <ToggleSwitch Header="Preserve motion peaks" IsOn="{Binding PreserveMotionPeaks, Mode=TwoWay}" />
                    <TextBlock Text="{Binding FrameOptimizationSummary}" TextWrapping="Wrap" Opacity="0.64" />

                    <TextBlock Text="{Binding FramePosition}" Opacity="0.64" />
                    <Button Content="Extract / Re-extract frames" Style="{StaticResource AccentButtonStyle}" Click="OnExtractClick" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Dependent work" Message="Re-extraction replaces frame state only after FFmpeg succeeds; existing valid results survive a failed attempt." />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>