<UserControl
    x:Class="SpriteForge.App.Views.Stages.ExportStageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="12" Padding="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="12" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Ready to export" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SheetSummary}" Opacity="0.68" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Latest result" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ExportSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="12">
                <TextBlock Text="EXPORT" Style="{StaticResource InspectorTitleStyle}" />
                <TextBlock Text="Export files" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Export name"/><TextBox Text="{Binding ExportName, Mode=TwoWay}" />
                <TextBlock Text="Destination"/>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ExportDestination, Mode=TwoWay}" IsReadOnly="True"/><Button Grid.Column="1" Content="Browse" Click="OnBrowseClick" /></Grid>
                <CheckBox Content="Sprite sheet PNG" IsChecked="True" IsEnabled="False" />
                <CheckBox Content="Metadata JSON" IsChecked="True" IsEnabled="False" />
                <CheckBox Content="Individual PNG frames" IsChecked="{Binding ExportIndividualFrames, Mode=TwoWay}" />
                <Button Content="Export" Style="{StaticResource AccentButtonStyle}" Click="OnExportClick" />
                <TextBlock Text="Existing files are never overwritten without explicit confirmation. Repeated exports are stored as immutable project history." TextWrapping="Wrap" Opacity="0.64" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
