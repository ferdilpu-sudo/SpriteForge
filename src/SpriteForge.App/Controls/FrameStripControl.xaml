<UserControl
    x:Class="SpriteForge.App.Controls.FrameStripControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SpriteForge.App.Controls">
    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Border Height="64"
                Padding="16,0"
                Visibility="{Binding HasFrames, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Frames" FontWeight="SemiBold" />
                <TextBlock Text="Frame thumbnails and editing controls will appear here after extraction." Opacity="0.58" />
            </StackPanel>
        </Border>

        <Grid Padding="12,6"
              RowSpacing="6"
              Visibility="{Binding HasFrames, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="80"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Enable / disable" Click="OnToggleClick" IsEnabled="{Binding HasSelectedFrame}" />
                <Button Content="←" ToolTipService.ToolTip="Move selected frame left" Click="OnMoveLeftClick" IsEnabled="{Binding HasSelectedFrame}" />
                <Button Content="→" ToolTipService.ToolTip="Move selected frame right" Click="OnMoveRightClick" IsEnabled="{Binding HasSelectedFrame}" />
                <Button Content="Duplicate" Click="OnDuplicateClick" IsEnabled="{Binding HasSelectedFrame}" />
                <Button Content="Remove" Click="OnRemoveClick" IsEnabled="{Binding HasSelectedFrame}" />
                <Button Content="Reset sequence" Click="OnResetClick" />
                <Rectangle Width="1" Height="24" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" />
                <TextBlock Text="Duration (ms)" VerticalAlignment="Center" Margin="4,0,0,0" />
                <NumberBox Width="104" Minimum="1" Maximum="60000" SmallChange="1" Value="{Binding SelectedFrameDurationMs, Mode=TwoWay}" IsEnabled="{Binding HasSelectedFrame}" />
                <Button Content="Apply" Click="OnApplyDurationClick" IsEnabled="{Binding HasSelectedFrame}" />
            </StackPanel>
            <ListView x:Name="FrameList" Grid.Row="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame, Mode=TwoWay}" SelectionMode="Single" SelectionChanged="OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="78" Height="72" Margin="2">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <controls:FileImageControl ImagePath="{Binding PreviewPath}" Margin="3" />
                                    <CheckBox IsChecked="{Binding Enabled}" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" />
                                    <Border VerticalAlignment="Bottom" Background="#99000000" Padding="4,1">
                                        <TextBlock Text="{Binding DisplayNumber}" HorizontalAlignment="Center" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
