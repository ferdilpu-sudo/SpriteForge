<UserControl
    x:Class="SpriteForge.App.Controls.CheckerboardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SpriteForge.App.Controls">
    <Grid x:Name="Root" Background="{ThemeResource LayerFillColorDefaultBrush}" SizeChanged="OnSizeChanged">
        <Canvas x:Name="Tiles" IsHitTestVisible="False" />
        <Border Margin="18" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <controls:FileImageControl x:Name="PreviewImage" Margin="8" RenderTransformOrigin="0.5,0.5">
                    <controls:FileImageControl.RenderTransform>
                        <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                    </controls:FileImageControl.RenderTransform>
                </controls:FileImageControl>
                <TextBlock x:Name="Placeholder" Text="MAIN PREVIEW" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45" FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
