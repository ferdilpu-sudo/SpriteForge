<Window
    x:Class="SpriteForge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SpriteForge.App.Controls">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="OnRootLoaded">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" Padding="12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="SpriteForge" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="18,0,0,0">
                <Button Content="New" Click="OnNewProjectClick" />
                <Button Content="Open" Click="OnOpenProjectClick" />
                <Button Content="Save" Click="OnSaveProjectClick" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="Project:" Opacity="0.58"/>
                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" />
            </StackPanel>
            <Button Grid.Column="3" Content="Diagnostics" VerticalAlignment="Center" Click="OnDiagnosticsClick" />
        </Grid>

        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid Padding="10,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="PIPELINE" Margin="8,0,0,8" FontSize="11" FontWeight="SemiBold" Opacity="0.62" />
                <ListView x:Name="StageList" Grid.Row="1" ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage, Mode=TwoWay}" SelectionChanged="OnStageSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="50" Padding="8,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" VerticalAlignment="Center" Opacity="0.55" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StateLabel}" FontSize="11" Opacity="0.62" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StateGlyph}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Margin="8,10,8,0" Spacing="2" ToolTipService.ToolTip="{Binding ProjectPath}">
                    <TextBlock Text="Local project" FontSize="11" FontWeight="SemiBold" Opacity="0.68" />
                    <TextBlock Text="Saved on this device" FontSize="10" Opacity="0.48" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ContentControl x:Name="StageHost" />
            <controls:FrameStripControl x:Name="FrameStrip" Grid.Row="1" DataContext="{Binding}" />
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid Padding="12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="PreviewPlayButton" Content="▶" ToolTipService.ToolTip="Play preview" Click="OnPreviewPlayClick" IsEnabled="{Binding HasFrames}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Opacity="{Binding PlaybackControlsOpacity}">
                    <TextBlock Text="{Binding PreviewFps}"/><TextBlock Text="FPS"/>
                </StackPanel>
                <ToggleButton Grid.Column="2" Content="Loop" IsChecked="{Binding LoopEnabled, Mode=TwoWay}" IsEnabled="{Binding HasFrames}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Opacity="{Binding ZoomControlsOpacity}">
                    <TextBlock Text="Zoom" Opacity="0.65" />
                    <TextBlock Text="{Binding PreviewZoomLabel}" Width="38" HorizontalAlignment="Right" />
                    <Slider Width="92" Minimum="0.25" Maximum="4" StepFrequency="0.25" Value="{Binding PreviewZoom, Mode=TwoWay}" IsEnabled="{Binding HasPreview}" />
                </StackPanel>
                <ProgressBar Grid.Column="4" Minimum="0" Maximum="1" Value="{Binding JobStatus.Progress}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FramePosition}" />
                    <TextBlock Text="{Binding JobStatus.Message}" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="6" Content="Cancel" IsEnabled="{Binding JobStatus.CanCancel}" Click="OnCancelClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
